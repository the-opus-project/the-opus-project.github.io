#!/bin/sh
set -eu
state=${FAKE_CLAUDE_STATE:-"$HOME/Library/Application Support/OPUS@Home/ci-claude"}
case "$1 $2" in
  "auth status")
    test "$3" = --json
    if test -f "$state/signed-in"; then
      echo '{"loggedIn":true}'
    else
      echo '{"loggedIn":false}'
      exit 1
    fi
    ;;
  "auth login")
    test "$3" = --claudeai
    touch "$state/signed-in"
    ;;
  *)
    test "$1" = -p
    case "$2" in *"Contribute one piece"*) ;; *) exit 1 ;; esac
    shift 2
    test "$1 $2 $3 $4 $5" = "--permission-mode bypassPermissions --output-format text --add-dir"
    test -d "$6"
    test -d .git
    test -f "$state/signed-in"
    printf '%s\n' "$6" > "$state/work-path"
    mkdir -p pieces/opus-ci-test/attempts
    printf '%s\n' '\version "2.26.0"' "{ c'1 }" > pieces/opus-ci-test/attempts/01.ly
    cat > OPUS_PR.md <<'BODY'
Test the local Claude contribution
Source: https://example.org/ci-fixture.pdf
Step: 1/3
Model: anthropic/ci-fixture
BODY
    ;;
esac
